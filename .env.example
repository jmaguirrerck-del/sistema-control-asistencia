# Neon / PostgreSQL
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/base?sslmode=require

# Administrador (prototipo institucional)
ADMIN_EMAIL=admin@ejemplo.gob.ar
ADMIN_PASSWORD=CambiarEstaClave

# Secreto largo para firmar la sesión administrativa (mínimo recomendado: 32 caracteres)
AUTH_SECRET=generar-una-cadena-larga-aleatoria-y-privada

# Opcional: si más adelante se activa un cron externo o Vercel Cron
CRON_SECRET=otra-cadena-larga-y-privada
